# کپی کنید: cp .env.example .env  (فایل .env را در Git قرار ندهید)
# مقادیر زیر نمونه آموزشی هستند؛ قبل از استفاده بیرون از کلاس تغییرشان دهید.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=book_catalog
POSTGRES_USER=book_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# cache پیش‌فرض (Throttling) روی دیتابیس 0 و cache پاسخ کتاب‌ها روی دیتابیس 1
REDIS_URL=redis://redis:6379/0
REDIS_BOOKS_URL=redis://redis:6379/1

BOOKS_CACHE_TTL=60
THROTTLE_RATE_ANON=10/min
THROTTLE_RATE_USER=30/min
THROTTLE_RATE_BOOK_SEARCH=5/min

# فقط برای seed_books --with-users
DEMO_STUDENT_PASSWORD=change-me-student
DEMO_ADMIN_PASSWORD=change-me-admin
